<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network state: read active network / DNS / link properties to feed the
         Wine prefix (NetworkHelper, NetworkInfoUpdateComponent, GuestProgramLauncherComponent). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Outbound HTTP from app code (e.g. shared/io/HttpUtils). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- In-app APK updates: hand a verified APK to the system package installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Haptic feedback / controller rumble (WinHandler). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Wine drive mappings: D: -> Downloads, F: -> external storage root
         (Container.DEFAULT_DRIVES, symlinked by WineUtils.createDosdevicesSymlinks).
         Without a storage grant Android's FUSE view still lists directories but
         filters out every file, so in-guest those drives show folders and nothing
         else. READ/WRITE covers legacy devices; targetSdk 36 uses the Android 11+
         MANAGE_EXTERNAL_STORAGE settings flow in GuestStorageAccess. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- GameSir X5s BLE rumble driver (API 31+). neverForLocation: scanning is
         for gamepad connectivity only, not to derive the user's location. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="31" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <application
        android:name=".AmphoraApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.Amphora">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|locale|layoutDirection|fontScale|uiMode"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- One Wine/Vulkan generation per process. The session process is deliberately
             not isolated: Wine, imagefs and content packages live under this app UID. -->
        <activity
            android:name=".gamesession.SessionActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|locale|layoutDirection|fontScale|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:process=":session"
            android:screenOrientation="sensorLandscape"
            tools:ignore="DiscouragedApi" />

        <!-- App-private cross-process bridge: the Wine :session process requests host metrics
             here because ShizukuProvider is intentionally initialized only in the main process. -->
        <service
            android:name="app.amphora.core.engine.PerformanceMetricsBridgeService"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Receives the optional Shizuku binder. Normal Wine teardown uses
             Amphora's own UID and does not depend on this provider. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
