<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network state: read active network / DNS / link properties to feed the
         Wine prefix (NetworkHelper, NetworkInfoUpdateComponent, GuestProgramLauncherComponent). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Outbound HTTP from app code (e.g. shared/io/HttpUtils). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Haptic feedback / controller rumble (WinHandler). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- GameSir X5s BLE rumble driver (API 31+). neverForLocation: scanning is
         for gamepad connectivity only, not to derive the user's location. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="31" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <application
        android:name=".AmphoraApplication"
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.Amphora">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|locale|layoutDirection|fontScale|uiMode"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
